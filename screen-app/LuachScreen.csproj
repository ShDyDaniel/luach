<Project Sdk="Microsoft.NET.Sdk">
  <!-- לוח הקומה — תוכנת מסך מלא ל-Windows.
       בנויה על .NET Framework 4.8 (מותקן בכל Windows 10/11) ו-WebView2 (מנוע הדפדפן של Windows),
       כך שלא צריך להתקין שום דבר נוסף. נבנית גם ממק/לינוקס:  dotnet build -c Release -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LuachScreen</AssemblyName>
    <RootNamespace>LuachScreen</RootNamespace>
    <ApplicationIcon>luach.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>לוח הקומה</Product>
    <Description>לוח הקומה — מסך מלא</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- WebView2Loader.dll גם ליד ה-exe (שם Windows מחפש אותו קודם), ובלי ספריית WPF שלא בשימוש. -->
  <Target Name="LuachTidyOutput" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)runtimes/win-x64/native/WebView2Loader.dll" DestinationFolder="$(OutDir)" />
    <Delete Files="$(OutDir)Microsoft.Web.WebView2.Wpf.dll" />
  </Target>
</Project>
